{
  "name": "svg-editor-cli",
  "version": "0.1.0",
  "description": "An object-oriented SVG editor command-line application",
  "type": "module",
  "bin": {
    "svg-editor": "dist/cli/SvgCli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "npm run build --silent && node dist/cli/SvgCli.js",
    "lint": "eslint src tests --no-error-on-unmatched-pattern",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check": "npm run lint && npm run build && npm run coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.7.2",
    "@vitest/coverage-v8": "4.1.6",
    "eslint": "10.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.6"
  }
}
